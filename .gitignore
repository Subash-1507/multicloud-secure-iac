# Terraform: never commit state, plans or real variable values
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
backend.hcl
!backend.hcl.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# Keep .terraform.lock.hcl committed: it pins provider checksums

# Ansible
*.retry
.vault_pass*

# Scanner output
*.sarif
results/

# Editors / OS / Python
.vscode/
.idea/
.DS_Store
__pycache__/
.venv/
